 				if (BurnDrvCartridgeSetup(CART_INIT_START)) {
+					recursing = false;
 					return 1;
 				}
 
@@ -4351,11 +4356,13 @@
 		nBurnDrvActive = nDriver;
 
 		if (BurnDrvCartridgeSetup(CART_INIT_END)) {
+			recursing = false;
 			return 1;
 		}
 
 	} else {
 		if (LoadRoms()) {
+			recursing = false;
 			return 1;
 		}
 	}
