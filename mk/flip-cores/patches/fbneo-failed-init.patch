+++ b/src/burn/drv/neogeo/neo_run.cpp
@@ -4300,6 +4300,10 @@
 
 	recursing = true;
 
+	// plorpOS: a failed load must not leave recursing set. It made the next game
+	// in the same process (a resident emulator) skip the hardware init and
+	// divide by zero on its first frame, and NeoExit free nothing (plorpos-f1p.95.15).
+
 	nNeoSystemType = NEO_SYS_CART;
 
 	if ((BurnDrvGetHardwareCode() & HARDWARE_PUBLIC_MASK) == HARDWARE_SNK_DEDICATED_PCB) {
@@ -4321,6 +4325,7 @@
