+// plorpOS (plorpos-f1p.95.12): a state made with Cyclone (the ARM 68000 core)
+// and one made with the C core lay the CPU out differently, and nothing in the
+// stream says which; restoring one with the other crashes. A Cyclone state
+// ends with four marker bytes, and each kind refuses the other.
+#ifdef USE_CYCLONE
+static const UINT8 cyclone_mark[4] = { 'C', 'Y', 'C', '1' };
+static size_t cyclone_mark_len() { return nSekCpuCore == SEK_CORE_C68K ? sizeof(cyclone_mark) : 0; }
+static bool cyclone_mark_ok(const void *data, size_t size)
+{
+	const bool marked = size >= sizeof(cyclone_mark) &&
+		memcmp((const UINT8*)data + size - sizeof(cyclone_mark), cyclone_mark, sizeof(cyclone_mark)) == 0;
+	if (marked != (cyclone_mark_len() != 0)) {
+		HandleMessage(RETRO_LOG_WARN, "[FBNeo] State refused: it was made with Cyclone %s\n", marked ? "on" : "off");
+		return false;
+	}
+	return true;
+}
+#else
+static size_t cyclone_mark_len() { return 0; }
+static bool cyclone_mark_ok(const void *, size_t) { return true; }
+#endif
+
 size_t retro_serialize_size()
 {
 	if (nBurnDrvActive == ~0U)
@@ -341,7 +363,7 @@
 	BurnAcb = StateLenAcb;
 	LibretroAreaScan(nAction);
 
-	return nStateLen[nSavestateContext];
+	return nStateLen[nSavestateContext] + cyclone_mark_len();
 }
 
