 	gp2x_set_video_mode(16,gfx_width,gfx_height);
diff --git a/src/mame.c b/src/mame.c
index 6daf751..9e0cdc0 100644
--- a/src/mame.c
+++ b/src/mame.c
@@ -173,8 +173,8 @@ int mame_start_game(int game)
 
     if(!iOS_fixedRes)
     {
-	  options.vector_width = 640;
-	  options.vector_height = 480;
+	  options.vector_width = 320;
+	  options.vector_height = 240;
     }
     else
     {
@@ -207,11 +207,9 @@ int mame_start_game(int game)
 	 * is then only a hint for the games where this can't apply (no
 	 * fixed-rate source, more than one distinct fixed rate, or a
 	 * source whose rate is decided at runtime). */
-	{
-		int fixed_rate = game_fixed_output_rate();
-		if (fixed_rate > 0)
-			Machine->sample_rate = fixed_rate;
-	}
+	/* plorpOS (RG Nano): keep the configured rate. Mixing every source at
+	 * e.g. the YM2151's ~55.9 kHz costs a single Cortex-A7 ~2.5x the audio
+	 * work per frame, and picoarch resamples it down again anyway. */
 
 	/* get orientation right */
 	Machine->orientation = gamedrv->flags & ORIENTATION_MASK;
