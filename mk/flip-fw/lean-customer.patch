--- a/main
+++ b/main
@@ -74,7 +74,10 @@ mkdir -p /var/run
 export LD_LIBRARY_PATH=/lib:/config/lib:/customer/lib
 /customer/app/axp_test poweron
 
-init_lcd 1
+# plorpOS (plorpos-f1p.38): no 1 s settle. The LCD is initialised by init_lcd's
+# `cat /proc/ls`; the sleep and the two sdldisplay splash draws below cost
+# ~4 s of boot before the SD card's updater could start.
+init_lcd 0
 
 if [ -f ${CUSTOMER_DIR}/exit_on_stage2 ] ; then
     exit 0
@@ -83,14 +86,15 @@ fi
 #wait for SDCARD mounted
 mounted=`cat /proc/mounts | grep SDCARD`
 cnt=0
-/customer/app/sdldisplay /customer/app/skin/icon-wait-tf-card_flipped.png
-while [ "$mounted" == "" ] && [ $cnt -lt 16 ] ; do
+#plorpOS: skipped, ~2 s each: /customer/app/sdldisplay /customer/app/skin/icon-wait-tf-card_flipped.png
+# plorpOS (plorpos-f1p.97): look every 0.1 s, not 0.5 s (same 8 s limit).
+while [ "$mounted" == "" ] && [ $cnt -lt 80 ] ; do
    echo "wait for sdcard $cnt $mounted"
-   sleep 0.5
+   sleep 0.1
    cnt=`expr $cnt + 1`
    mounted=`cat /proc/mounts | grep SDCARD`
 done
-/customer/app/sdldisplay /customer/app/skin/app_loading_bg_flipped.png
+#plorpOS: skipped, ~2 s each: /customer/app/sdldisplay /customer/app/skin/app_loading_bg_flipped.png
 if [ "$mounted" != "" ] ; then
    insmod /mnt/SDCARD/8188fu.ko
    for f in `ls /mnt/SDCARD/boot/*.ko` ; do
@@ -98,11 +102,18 @@ if [ "$mounted" != "" ] ; then
    done
 fi
 
-networktime=`/customer/app/jsonval usenetworktime` 
+# plorpOS (plorpos-f1p.97): read the two settings with sed. jsonval's first
+# run pages ~20 libraries (SDL, freetype, mi_*) in from flash; same answers,
+# empty when the key is missing.
+settings_value(){
+   f=/appconfigs/system.json; [ -f $f ] || f=/mnt/SDCARD/system.json
+   sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\{0,1\}\([^",}[:space:]]*\).*/\1/p' $f 2>/dev/null | head -n 1
+}
+networktime=`settings_value usenetworktime`
 if [ "$networktime" != "0" ] ; then
    /customer/ntpd.sh start
 fi 
-timezone=`/customer/app/jsonval timezone`
+timezone=`settings_value timezone`
 if [ "$timezone" != "" ] && [ -d /mnt/SDCARD/miyoo285/zoneinfo ] ; then
    ln -sf /mnt/SDCARD/miyoo285/zoneinfo/$timezone /tmp/localtime
 else
