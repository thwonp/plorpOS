#!/bin/sh
# The Miyoo Mini Flip's boot hook (plorpos-f1p.12): the stock firmware's
# /customer/main runs /mnt/SDCARD/.tmp_update/updater, when there is one, in
# place of Miyoo's MainUI. This one starts plorpOS.
#
# When plorpOS cannot start (no plorpOS/launch.sh, or its launch loop gives up
# after five launcher failures in a row) the hook hands the device back to
# the stock MainUI (plorpos-f1p.62.1). The stock main runs `rm -rf
# .tmp_update` as soon as this script returns, so the hook first moves its
# own folder aside to .tmp_update.off: main then finds no .tmp_update and
# starts MainUI, and the hook survives. To boot plorpOS again, rename
# .tmp_update.off back to .tmp_update (from a PC).
#
# plorpOS/.boot-idle: stay up instead (for ssh) rather than starting MainUI.
# plorpOS/.fallback-test: TEST ONLY, the fallback re-arms the hook, runs the
# marker's lines (to undo the test's trigger) and reboots after 60 s, so an
# unattended test heals itself.
ROOT=/mnt/SDCARD
T=$ROOT/.tmp_update
# plorpOS/, or TortOS/ on a card the rename has not reached yet (plorpos-nzi):
# the first launch from plorpOS/ moves what is left in TortOS/ and deletes it.
L=$ROOT/plorpOS
[ -f "$L/launch.sh" ] || L=$ROOT/TortOS

boot_fallback() {
	if [ -f "$L/.boot-idle" ]; then
		while :; do sleep 3600; done
	fi
	rm -rf "$ROOT/.tmp_update.off"
	mv "$T" "$ROOT/.tmp_update.off" || while :; do sleep 3600; done
	if [ -f "$L/.fallback-test" ]; then
		# the marker's own lines undo whatever the test did to force the fallback
		mv "$L/.fallback-test" /tmp/fallback-test.sh
		( sleep 60; mv "$ROOT/.tmp_update.off" "$T"; sh /tmp/fallback-test.sh; sync; reboot ) > /dev/null 2>&1 &
	fi
	sync
	exit 0
}
[ -f "$L/launch.sh" ] || boot_fallback

export LD_LIBRARY_PATH=/lib:/config/lib:/customer/lib

# Backlight and panel as the stock firmware brings them up, at the saved
# level from the start (plorpos-f1p.99): the duty of boot.env's BRIGHTNESS,
# from platform_miyoo.c's ladder (keep the two the same), or 50 on a card
# the launcher has not written yet. The panel helper that cat /proc/ls
# starts (/dev/l) sets duty 10 x the stock system.json "brightness" about
# 2 s later, so that value is matched to the level too, written only when
# it differs.
DUTY=50
LEVEL=$(sed -n "s/^BRIGHTNESS='\([0-9]*\)'\$/\1/p" "$ROOT/.userdata/miyooflip/boot.env" 2> /dev/null)
i=0
for d in 3 5 8 12 17 24 33 44 56 70 85 100; do
	[ "$i" = "$LEVEL" ] && DUTY=$d
	i=$((i + 1))
done
J=/appconfigs/system.json
if [ -n "$LEVEL" ] && [ -f "$J" ]; then
	S=$(((DUTY + 5) / 10))
	grep -q "\"brightness\":[[:space:]]*$S," "$J" ||
		sed -i "s/\(\"brightness\":[[:space:]]*\)[0-9]*,/\1$S,/" "$J"
fi
echo 0 > /sys/class/pwm/pwmchip0/export 2> /dev/null
echo 800 > /sys/class/pwm/pwmchip0/pwm0/period
echo $DUTY > /sys/class/pwm/pwmchip0/pwm0/duty_cycle
echo 1 > /sys/class/pwm/pwmchip0/pwm0/enable
cat /proc/ls > /dev/null
# The stock telnetd (passwordless root): plorpOS's ssh, off by default, is
# switched on in Network Services instead (plorpOS/launch.sh starts it).
killall telnetd 2> /dev/null
ifconfig lo up

sh "$L/launch.sh"
boot_fallback
