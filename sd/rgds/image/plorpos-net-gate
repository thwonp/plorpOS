#!/bin/sh
# Holds a network service (iwd, avahi) until the launcher has drawn the shelf
# (plorpos-rgds.12): started with the rest at 6 s they share four saturated
# cores with sway and the launcher. launch.sh touches the marker at the
# launcher's first frame. Bounded, so the card out (stock ES, no launch.sh)
# still gets its network, 20 s in. Installed as /usr/lib/rocknix/plorpos-net-gate.
i=0
while [ ! -e /run/plorpos-shelf ] && [ $i -lt 80 ]; do
	sleep 0.25
	i=$((i + 1))
done
exit 0
