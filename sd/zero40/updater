#!/bin/sh
# plorpOS on the MagicX Zero 40: oakMOSS's runmagicx.sh runs this from the
# card that hosts (/mnt/SDCARD: SD2, or SD1's SPRUCEOS partition) and powers
# the board off when it returns.
#
# /usr/magicx/device names the board (oakMOSS boards/<board>/board.conf); the
# Zero 28 and XU20 run the same base but are other machines plorpOS has never
# run on, so anything but zero40 is left alone rather than half-booted.
[ "$(cat /usr/magicx/device 2> /dev/null)" = zero40 ] || exit 1

LAUNCH=/mnt/SDCARD/plorpOS/launch.sh
[ -f "$LAUNCH" ] && sh "$LAUNCH"
